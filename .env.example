# Copy to `.env` in the repo root (or `apps/agent/.env`).
# Never commit real nsecs, mint tokens, or API keys.

# Going live? Use `.env.live.example` instead and read docs/LIVE.md.
# `pnpm live:check` validates this file without contacting relays/mint/LLM.

# --- Runtime ---
# Keep true for local dev. Mock Nostr uses POST /dev/inbound instead of relay
# sockets; mock Cashu uses POST /dev/mark-paid instead of mint settlement.
# MOCK_MODE=true always mocks nostr + cashu + llm even if URLs/keys are set.
MOCK_MODE=true
# Strict production flip. LIVE_MODE=true (with MOCK_MODE=false) REFUSES TO
# START unless NOSTR_NSEC, CASHU_MINT_URL, LLM_API_KEY and a real LLM_MODEL are
# set AND the mint, LLM endpoint and at least one relay answer at boot.
# MOCK_MODE=false without LIVE_MODE = partial flip: missing pieces stay mocked
# (logged as warnings and reported on /health -> runtime.subsystems).
LIVE_MODE=false
NODE_ENV=development
# Boot-time reachability probes for live subsystems (fatal only in LIVE_MODE).
LIVE_STARTUP_PROBES=true
LIVE_RELAY_CONNECT_TIMEOUT_MS=15000

# Local status API (dashboard polls this; bind loopback only).
AGENT_HTTP_HOST=127.0.0.1
AGENT_HTTP_PORT=3847

# --- Nostr ---
# Comma-separated relay URLs. Used when MOCK_MODE is false (and NOSTR_NSEC is set).
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol
# nsec1... private key for the agent identity. Leave empty in mock mode
# (an ephemeral npub is generated each process start and is not persisted).
NOSTR_NSEC=

# --- Cashu / Lightning ---
# Mint URL for live quotes + receive. Ignored while MOCK_MODE=true.
# Public test mint (FakeWallet — invoices auto-mark paid):
#   CASHU_MINT_URL=https://testnut.cashu.space
# Live fetch_url melts TOOL_SPEND_SATS to a mint-issued invoice (self-pay, not reminted).
CASHU_MINT_URL=
# Sats required before a full LLM reply is sent.
PAYMENT_GATE_SATS=21
# Sats the agent may spend from its own wallet to call fetch_url.
TOOL_SPEND_SATS=10
# HTTP timeout for fetch_url.
TOOL_FETCH_TIMEOUT_MS=8000
# Mock wallet opening balance (sats) when Cashu is mocked.
MOCK_BALANCE_SATS=210
# Paid session lifetime after mark-paid (seconds).
SESSION_TTL_SECONDS=900
# Unpaid quote lifetime (seconds).
QUOTE_TTL_SECONDS=3600
# Ignore extra unpaid paywall replies from the same pubkey (ms). 0 disables.
UNPAID_COOLDOWN_MS=10000
# JSON file for sessions, relative to apps/agent unless absolute.
SESSION_STORE_PATH=data/sessions.json

# --- LLM ---
# OpenAI-compatible endpoint. Unused while MOCK_MODE=true (or if empty).
# When LLM_API_KEY is set, LLM_MODEL must be a real model id for that provider.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=mock-npubbot
LLM_TIMEOUT_MS=30000

# --- Dashboard (Vite; only VITE_* is exposed to the browser) ---
# Default `/agent` is proxied to the status API. Use an absolute URL
# if the dashboard is not served by Vite's proxy.
VITE_AGENT_BASE_URL=/agent
