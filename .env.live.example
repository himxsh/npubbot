# NpubBot LIVE template — Nostr + Cashu + LLM all real.
#   cp .env.live.example .env    (then fill the three REQUIRED secrets)
#   pnpm live:check              (offline validation, exit 1 if anything missing)
#   pnpm agent                   (refuses to start unless everything is live + reachable)
# NEVER commit the filled-in file. `.env` is gitignored.

MOCK_MODE=false
LIVE_MODE=true
NODE_ENV=production
LIVE_STARTUP_PROBES=true
LIVE_RELAY_CONNECT_TIMEOUT_MS=15000

# Loopback only: /dev/* exist only on loopback hosts. Do not expose publicly.
AGENT_HTTP_HOST=127.0.0.1
AGENT_HTTP_PORT=3847

# --- Nostr (REQUIRED) ---
# Agent identity private key, bech32 nsec1…  Use a dedicated bot key, not your
# personal one. Its npub is printed at startup and on /status.
NOSTR_NSEC=
NOSTR_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.primal.net

# --- Cashu (REQUIRED) ---
# https:// mint URL. testnut = FakeWallet (auto-paid invoices, NOT real sats):
#   CASHU_MINT_URL=https://testnut.cashu.space
# Real sats: a mainnet mint you trust (invoices must actually be paid over LN).
CASHU_MINT_URL=
PAYMENT_GATE_SATS=21
TOOL_SPEND_SATS=10
TOOL_FETCH_TIMEOUT_MS=8000
MOCK_BALANCE_SATS=0
SESSION_TTL_SECONDS=900
QUOTE_TTL_SECONDS=3600
UNPAID_COOLDOWN_MS=10000
SESSION_STORE_PATH=data/sessions.json

# --- LLM (REQUIRED) ---
# Any OpenAI-compatible /chat/completions endpoint + key + a real model id
# for that provider (mock-npubbot is rejected in LIVE_MODE).
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=
LLM_TIMEOUT_MS=30000

VITE_AGENT_BASE_URL=/agent
